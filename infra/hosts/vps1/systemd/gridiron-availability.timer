# Friday availability refresh: Friday 22:00 UTC = Friday 17:00 EST (UTC-5, November).
#
# Persistent=false (the default, stated): after downtime a missed refresh does NOT catch up on boot.
# By then the week may have kicked off, and the job refuses a week with a passed kickoff anyway.
# The box runs on UTC (bootstrap.sh forces it); no Timezone= is set on purpose.
[Unit]
Description=Friday Gridiron availability refresh - Friday 22:00 UTC (17:00 EST)

[Timer]
OnCalendar=Fri *-*-* 22:00:00
Persistent=false
Unit=gridiron-availability.service

[Install]
WantedBy=timers.target
