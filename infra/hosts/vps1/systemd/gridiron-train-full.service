# Full retrain window job: Friday 23:30 UTC → Monday 06:00 UTC.
#
# RuntimeMaxSec=54h 30min (Fri 23:30 to Mon 06:00) enforces the window end even mid-run;
# the missing dead-man ping surfaces the overrun. A full retrain that cannot
# fit Fri-night-through-weekend on 5 capped vCores is an envelope question
# for the owner (see README "Training slice"), not a reason to overrun into
# the Tuesday ETL — the ETL's Conflicts= stops this unit first anyway.
[Unit]
Description=Gridiron full retrain (Fri 23:30–Mon 06:00 UTC)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
# The launcher script reads TRAIN_*_CMD and the healthchecks URL from the environment.
# systemd does not read .env; without this line the script exits "TRAIN_..._CMD is unset"
# (found 2026-11-15: train-small failed every night). No "-" prefix on purpose: a missing
# .env must fail the unit loudly. Value syntax rules: .env.example, "systemd also reads .env".
EnvironmentFile=/srv/gridiron/infra/hosts/vps1/.env
Slice=gridiron-training.slice
Nice=10
RuntimeMaxSec=54h 30min
ExecStart=/srv/gridiron/infra/hosts/vps1/scripts/train_full.sh
