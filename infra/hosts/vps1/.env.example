# Gridiron site environment template (shared VPS-4) — NAMES ONLY, EMPTY VALUES.
#
# Copy to `.env` (same directory, mode 0600, owned by deploy — NEVER in git;
# the pre-push hook and CI push-gate block secrets) and fill in on the box:
#   cp .env.example .env && chmod 600 .env && chown deploy:deploy .env
#
# Secret hygiene: generate fresh on the VPS (no dev reuse), `read -s` entry,
# and never echo values into logs or chat.
#
# Accepted v1: PLAIN .env at mode 0600 (see README "Secrets" for the sops/age
# path this layout is ready to adopt later — no compose changes needed).
#
# systemd also reads .env (EnvironmentFile= on gridiron-train-small/-full.service),
# and it parses differently from docker compose. Write every value so both agree:
#   - one NAME=value per line, no quotes, no `$`, no backslashes, no `export`;
#   - comments only on their own line, never after a value (systemd would keep
#     the `# ...` text as part of the value; compose strips it);
#   - spaces inside a value are fine (TRAIN_*_CMD below) and are kept as written.
# Check on the box after editing: README "Training slice", "Checking .env".

# ── Database ─────────────────────────────────────────────────────────────────
# MUST match between db and api (compose defaults both to oracle/oracle only
# for smoke tests — set a real password here before any real data lands).
DATABASE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# ── API auth ─────────────────────────────────────────────────────────────────
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
# PRODUCT_MODE=artifact_backed with empty API_KEY warns at startup and serves
# unauthenticated — fine for a smoke test, not for real traffic.
API_KEY=
ADMIN_API_KEY=
MODEL_VERSION=
PRODUCT_MODE=artifact_backed
CORS_ORIGINS=

# ── Release baseline (defaults in code usually suffice) ──────────────────────
BASELINE_MANIFEST_PATH=
ARTIFACT_INVALIDATION_PATH=

# ── External data APIs (free tiers; empty = feature reports unconfigured) ───
ODDS_API_KEY=
ODDS_MIN_REMAINING=
OPENWEATHER_API_KEY=

# ── Tunnel (Cloudflare) ──────────────────────────────────────────────────────
# Token for the pre-created `gridiron-vps1` tunnel (owner: `cloudflared
# tunnel create` + DNS route — see README bring-up step 5).
TUNNEL_TOKEN=

# ── Backups → Cloudflare R2 ──────────────────────────────────────────────────
# R2_* names chosen for this box. Least-privilege token: Object Read & Write
# on the backups bucket only. Endpoint form:
# https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_BACKUPS=
# Optional age recipient for dump encryption (strongly recommended;
# `age-keygen -o age.key` owner-side, public key here). Unset = gzip-only.
AGE_RECIPIENT=

# ── Dead-man pings (healthchecks.io, names only) ─────────────────────────────
# Each job pings on SUCCESS only; a missing ping is the alert.
HEALTHCHECKS_BACKUP_URL=
HEALTHCHECKS_ETL_URL=
HEALTHCHECKS_AVAILABILITY_URL=
HEALTHCHECKS_TRAIN_SMALL_URL=
HEALTHCHECKS_TRAIN_FULL_URL=

# ── Training recipes (pinned 2026-11-14; see README "Training slice") ───────
# Run inside /app by scripts/train_small.sh / train_full.sh. Word-split, so no
# env assignments here; the recipe logic lives in scripts/train_window.sh.
# The script gets these from systemd's EnvironmentFile= (see the top of this file).
TRAIN_SMALL_CMD=bash scripts/train_window.sh small
TRAIN_FULL_CMD=bash scripts/train_window.sh full

# ── Release provenance ───────────────────────────────────────────────────────
# /srv/gridiron has no .git, so the api cannot read HEAD. Set this to the full
# commit sha the deployed code and releases/ were built from; readiness compares
# it with releases/current_baseline.json "git_commit". Empty = readiness fails
# closed. Update it on every deploy (docs/runbooks/vps4-causal-rerun.md).
GIT_COMMIT_SHA=

# ── Observability (profile `observability` only) ─────────────────────────────
OTEL_TRACES_EXPORTER=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=
