# ── Database ───────────────────────────────────────────────────────────────────
# PostgreSQL DSN used by the FastAPI backend and ETL pipeline.
# docker-compose credentials: user=oracle  password=oracle  db=oracle
DATABASE_URL=postgresql+asyncpg://oracle:oracle@db:5432/oracle

# For local dev (outside Docker), use localhost instead of db:
# DATABASE_URL=postgresql://oracle:oracle@localhost:15439/oracle

# ── ML Experiment Tracking ─────────────────────────────────────────────────────
# MLflow tracking server URI for host processes. Docker publishes :15091;
# containers use http://mlflow:5001 (set in infra/docker-compose.yml).
MLFLOW_TRACKING_URI=http://localhost:15091

# ── Model Version Tag ─────────────────────────────────────────────────────────
# Written into every /predict response for traceability.
# Set to a semantic version or MLflow run ID after each retrain.
MODEL_VERSION=latest

# ── Product Mode ──────────────────────────────────────────────────────────────
# artifact_backed: require real model/backtest artifacts to be present
# graceful_fallback: allow synthetic/fallback paths and label them explicitly
PRODUCT_MODE=artifact_backed

# ── Release Baseline ──────────────────────────────────────────────────────────
# Path to the promoted baseline manifest used by /integrity and artifact-backed
# readiness checks. Generate with: python scripts/freeze_baseline.py
BASELINE_MANIFEST_PATH=releases/current_baseline.json
ARTIFACT_INVALIDATION_PATH=releases/artifact_invalidations.json

# ── External APIs (free tier — see CLAUDE.md §6) ──────────────────────────────
# the-odds-api.com · 500 req/month free tier
# Register at: https://the-odds-api.com
ODDS_API_KEY=

# openweathermap.org · 1,000 req/day free tier
# Register at: https://openweathermap.org/api
OPENWEATHER_API_KEY=

# ── C++ Engine ────────────────────────────────────────────────────────────────
# Path to the JSON config consumed by the C++ execution engine at startup.
# The file stores: Kelly fraction, max_exposure_pct, signal_threshold.
ENGINE_CONFIG_PATH=engine/config/engine_config.json

# ── API Server ─────────────────────────────────────────────────────────────────
# Comma-separated CORS origins. Defaults to localhost dev servers when unset.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# API key guard. Leave blank for local dev (auth is disabled when empty).
# When set, every request must include the header:  X-API-Key: <value>
# Health/docs endpoints (/health /integrity /docs /redoc) are always exempt.
# Generate a key: python3 -c "import secrets; print(secrets.token_hex(32))"
API_KEY=

# Log level for the FastAPI backend.  One of: DEBUG INFO WARNING ERROR
LOG_LEVEL=INFO

# ── User Settings ─────────────────────────────────────────────────────────────
# Path to the JSON file that stores user weight overrides for /settings PUT.
# Written by the Settings page slider, read by the model ensemble on next run.
SETTINGS_FILE=user_config.json

# ── Apple Silicon OpenMP fix (M1/M2/M3 Macs) ──────────────────────────────────
# Required when XGBoost + PyTorch + scikit-learn are all imported in the same
# process.  Each package bundles its own libomp.dylib; without this flag all
# three load simultaneously and deadlock each other in the OpenMP thread barrier,
# causing a SIGSEGV (exit code 139) during any ML training call.
#
# Add both to your shell profile so every terminal session inherits them:
#   echo 'export KMP_DUPLICATE_LIB_OK=TRUE' >> ~/.zshrc
#   echo 'export OMP_NUM_THREADS=1'          >> ~/.zshrc
#
# This is NOT a code bug — it is a Homebrew/ARM packaging issue.
# Documented in: CLAUDE.md §2.
KMP_DUPLICATE_LIB_OK=TRUE
OMP_NUM_THREADS=1
