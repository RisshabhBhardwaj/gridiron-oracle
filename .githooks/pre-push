#!/usr/bin/env bash
# Public-push gate for gridiron-oracle.
# Rejects pushes that would publish private, secret, or bulky non-public paths.
set -euo pipefail

BLOCK_PATTERNS=(
  '^\.env$'
  '^\.env\.'
  '\.key$'
  '\.pem$'
  '^secrets/'
  '^mutants/'
  '^archive/run_pre_'
  'ACTIVE_PROJECTS_AUDIT_'
  '_gridiron_archive'
  'gridiron-private-history\.bundle'
)

zero_sha="0000000000000000000000000000000000000000"
blocked=0

while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ "$local_sha" == "$zero_sha" ]]; then
    continue
  fi

  if [[ "$remote_sha" == "$zero_sha" ]]; then
    range="$local_sha"
  else
    range="${remote_sha}..${local_sha}"
  fi

  while IFS= read -r path; do
    [[ -z "$path" ]] && continue
    for pat in "${BLOCK_PATTERNS[@]}"; do
      if [[ "$path" =~ $pat ]]; then
        echo "PUBLIC-PUSH GATE: blocked path '$path' (matched /$pat/)" >&2
        blocked=1
      fi
    done
  done < <(git diff-tree --no-commit-id --name-only -r "$range")
done

if [[ "$blocked" -ne 0 ]]; then
  echo "PUBLIC-PUSH GATE: push rejected. Remove non-public paths and try again." >&2
  exit 1
fi

exit 0
