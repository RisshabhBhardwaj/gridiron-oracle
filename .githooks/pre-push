#!/usr/bin/env bash
# Public-push gate for gridiron-oracle.
#
# Rejects pushes that would publish private, secret, or bulky non-public
# objects. Scans EVERY object introduced by the push — not just the tip
# commit and not just the endpoint diff — so a blocked path committed in an
# ancestor and deleted before the tip is still caught.
#
# THIS HOOK IS CONVENIENCE, NOT A SECURITY BOUNDARY. It runs on the pusher's
# machine and can be skipped with `--no-verify`. The authoritative gate is the
# `push-gate` job in .github/workflows/ci.yml (required check). See
# CONTRIBUTING.md § "Public-push gate".
set -uo pipefail

remote_name="${1:-origin}"

# Explicitly public templates (must not be blocked by .env.* rules).
ALLOW_EXACT=(
  '.env.example'
)

# Path patterns. Anchored with (^|/) so nested copies are caught too.
BLOCK_PATTERNS=(
  '(^|/)\.env$'
  '(^|/)\.env\.'
  '\.key$'
  '\.pem$'
  '(^|/)secrets/'
  '(^|/)mutants/'
  '(^|/)archive/run_pre_'
  'ACTIVE_PROJECTS_AUDIT_'
  '_gridiron_archive'
  'gridiron-private-history\.bundle'
)

# Content patterns. Deliberately built in rather than delegating entirely to
# gitleaks: the gate must enforce identically on a CI runner that has no
# gitleaks binary. gitleaks, when present, runs as an additional layer.
SECRET_PATTERNS=(
  '-----BEGIN [A-Z ]*PRIVATE KEY-----'
  'AKIA[0-9A-Z]{16}'
  'ASIA[0-9A-Z]{16}'
  'ghp_[A-Za-z0-9]{36}'
  'github_pat_[A-Za-z0-9_]{22,}'
  'xox[abprs]-[A-Za-z0-9-]{10,}'
  'sk-[A-Za-z0-9]{32,}'
  'sk-ant-[A-Za-z0-9_-]{20,}'
  'AIza[0-9A-Za-z_-]{35}'
  '(api[_-]?key|secret[_-]?key|access[_-]?token|client[_-]?secret|password)[[:space:]]*[:=][[:space:]]*['\''"]?[A-Za-z0-9/+_-]{16,}'
)

# Objects larger than this are refused. The largest object in public history
# is ~3.4 MB (ml/oof/_history_fantasy_ppr_2019_2025.csv); this leaves headroom
# without letting bulk artifacts through.
MAX_OBJECT_BYTES="${PUSH_GATE_MAX_OBJECT_BYTES:-5242880}"


zero_sha="0000000000000000000000000000000000000000"
blocked=0

is_allowed() {
  local path="$1"
  local allowed
  for allowed in "${ALLOW_EXACT[@]}"; do
    if [[ "$path" == "$allowed" ]]; then
      return 0
    fi
  done
  return 1
}

scan_paths() {
  # stdin: "<sha> <path>" lines (path may contain spaces; may be empty)
  local sha path pat
  while IFS= read -r line; do
    sha="${line%% *}"
    path="${line#* }"
    [[ "$path" == "$sha" ]] && continue   # commit/tag object: no path
    [[ -z "$path" ]] && continue
    is_allowed "$path" && continue
    for pat in "${BLOCK_PATTERNS[@]}"; do
      if [[ "$path" =~ $pat ]]; then
        echo "PUBLIC-PUSH GATE: blocked path '$path' (matched /$pat/)" >&2
        blocked=1
      fi
    done
  done
}

scan_sizes() {
  # stdin: "<sha> <path>" lines, deduped by sha upstream (bash 3.2 has no
  # associative arrays).
  local objects sizes pat
  objects="$(cat)"
  [[ -z "$objects" ]] && return 0

  # Batched size check: one `cat-file` process for every object in the push.
  sizes="$(
    awk '{print $1}' <<<"$objects" \
      | git cat-file --batch-check='%(objectname) %(objecttype) %(objectsize)' 2>/dev/null
  )"
  while read -r sha type size; do
    [[ "$type" == "blob" ]] || continue
    [[ -n "$size" ]] || continue
    if (( size > MAX_OBJECT_BYTES )); then
      local objpath
      objpath="$(awk -v s="$sha" '$1==s { $1=""; sub(/^ /,""); print; exit }' <<<"$objects")"
      echo "PUBLIC-PUSH GATE: object too large: '${objpath:-$sha}' (${size} bytes > ${MAX_OBJECT_BYTES})" >&2
      blocked=1
    fi
  done <<<"$sizes"
}

scan_secrets() {
  # Content scan across every commit introduced by the push, so a secret added
  # and removed inside the range is still seen. `git grep` over the commit list
  # is one process for the whole push; per-blob grep was ~50x slower.
  local commits="$1"
  local args=() pat hits
  [[ -z "$commits" ]] && return 0
  for pat in "${SECRET_PATTERNS[@]}"; do
    args+=(-e "$pat")
  done
  # -I skips binary blobs; -l lists "<rev>:<path>" once per match.
  # shellcheck disable=SC2086 -- $commits is an intentional word-split rev list.
  hits="$(git grep -EIil "${args[@]}" $commits -- 2>/dev/null || true)"
  if [[ -n "$hits" ]]; then
    while IFS= read -r hit; do
      [[ -z "$hit" ]] && continue
      echo "PUBLIC-PUSH GATE: possible secret in '${hit}'" >&2
    done <<<"$hits"
    blocked=1
  fi
}

run_gitleaks() {
  # Additional layer when available. Never the only layer — see SECRET_PATTERNS.
  local local_sha="$1"
  local log_opts rc

  if ! command -v gitleaks >/dev/null 2>&1; then
    if [[ "${CI:-}" == "true" ]]; then
      echo "PUBLIC-PUSH GATE: gitleaks is required in CI but was not found on PATH." >&2
      blocked=1
    else
      echo "PUBLIC-PUSH GATE: note — gitleaks not installed; built-in content scan only." >&2
    fi
    return
  fi

  log_opts="$local_sha --not --remotes=$remote_name"

  # The CLI was reworked mid-v8: `gitleaks git` replaced `gitleaks detect`.
  # Pick whichever the installed binary actually has rather than assuming.
  if gitleaks git --help >/dev/null 2>&1; then
    gitleaks git --no-banner --redact --log-opts="$log_opts" . >&2
    rc=$?
  elif gitleaks detect --help >/dev/null 2>&1; then
    gitleaks detect --no-banner --redact --source=. --log-opts="$log_opts" >&2
    rc=$?
  else
    echo "PUBLIC-PUSH GATE: gitleaks is installed but exposes neither 'git' nor 'detect'." >&2
    blocked=1
    return
  fi

  # Distinguish findings from a broken invocation: gitleaks exits 1 on leaks,
  # and something else (usage/config error) when the tool itself failed. Both
  # block, but a required check whose failure mode is unreadable is not one.
  case "$rc" in
    0) ;;
    1)
      echo "PUBLIC-PUSH GATE: gitleaks reported findings." >&2
      blocked=1
      ;;
    *)
      echo "PUBLIC-PUSH GATE: gitleaks failed to run (exit $rc) — not a clean scan." >&2
      blocked=1
      ;;
  esac
}

while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ "$local_sha" == "$zero_sha" ]]; then
    continue   # branch deletion: nothing published
  fi

  # Uniform enumeration for both new and existing refs. Listing every object
  # reachable from the pushed tip but not from any remote-tracking ref is
  # correct in both cases; the old `remote_sha..local_sha` endpoint diff made
  # add-then-delete-within-range invisible, and the new-ref branch scanned
  # only one commit.
  objects="$(git rev-list --objects --root "$local_sha" --not --remotes="$remote_name" 2>/dev/null || true)"
  if [[ -z "$objects" ]]; then
    # Nothing new to publish. Legitimate locally (an already-pushed tip); in CI
    # it means the scan enumerated nothing, and a required check that can pass
    # vacuously is not a check.
    if [[ "${CI:-}" == "true" ]]; then
      echo "PUBLIC-PUSH GATE: no objects to scan for $local_sha — refusing to pass vacuously." >&2
      blocked=1
    fi
    continue
  fi
  commits="$(git rev-list --root "$local_sha" --not --remotes="$remote_name" 2>/dev/null || true)"

  scan_paths <<<"$objects"
  scan_sizes <<<"$(awk '!seen[$1]++' <<<"$objects")"
  scan_secrets "$commits"
  run_gitleaks "$local_sha"
done

if [[ "$blocked" -ne 0 ]]; then
  echo "PUBLIC-PUSH GATE: push rejected. Remove non-public paths and try again." >&2
  exit 1
fi

exit 0
